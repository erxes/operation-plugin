{
  "name": "operation_api",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "api",
        "commands": [
          "pnpm build"
        ]
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "api",
        "command": "NODE_ENV=development node dist/src/main.js"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "api",
        "command": "NODE_ENV=development pnpm dev"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "api",
        "command": "pnpm exec jest --config jest.config.ts --runInBand --passWithNoTests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint api"
      }
    },
    "docker-build": {
      "dependsOn": [
        "build"
      ],
      "command": "docker build -f api/Dockerfile . -t erxes/erxes-next-operation_api"
    }
  }
}
